# ---- Copy these into Railway → your service → Variables ----

# Where the bot saves its memory. Add a Railway Volume mounted at /data.
DATA_DIR=/data

# Password for the Pause / Close-all buttons on the dashboard (pick your own).
DASHBOARD_PASSWORD=change-me

# ---- Hunter's view of X (pick one, optional) ----
# Best: an X API bearer token (developer.x.com, paid "Basic" plan needed for search)
X_BEARER_TOKEN=
# Or: a Claude API key (console.anthropic.com). Hunter asks Claude to search X for the coin.
ANTHROPIC_API_KEY=
HUNTER_LLM_PER_HOUR=12
# With neither, the Hunter judges the coin's own X / Telegram / website links only.

# ---- Practice money settings ----
START_BALANCE_SOL=1
TRADE_SIZE_SOL=0.05
MAX_OPEN_POSITIONS=3
TAKE_PROFIT_PCT=60
STOP_LOSS_PCT=25
TRAILING_STOP_PCT=20
MAX_HOLD_MINUTES=15
DAILY_LOSS_LIMIT_SOL=0.25

# ---- REAL MONEY (leave off until the practice record is good) ----
LIVE_TRADING=false
PUMPPORTAL_API_KEY=
WALLET_PUBLIC_KEY=
MAX_LIVE_TRADE_SOL=0.25

# Testing only: fake coins instead of real pump.fun
SIMULATE=false
