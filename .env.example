# ---- Copy these into Railway → your service → Variables ----

# Where the bot saves its memory. Add a Railway Volume mounted at /data.
DATA_DIR=/data

# Password for the Pause / Close-all buttons on the dashboard (pick your own).
DASHBOARD_PASSWORD=change-me

# ---- Hunter's view of X (pick one, optional) ----
# X API bearer token (developer.x.com, pay-per-use: about $0.005 per post read, so ~$0.05 per check)
X_BEARER_TOKEN=
X_CHECKS_PER_HOUR=6
# Or: a Claude API key (console.anthropic.com). Hunter asks Claude to search X for the coin.
ANTHROPIC_API_KEY=
HUNTER_LLM_PER_HOUR=4
# With neither, the Hunter judges the coin's own X / Telegram / website links only.

# ---- Practice money settings ----
START_BALANCE_SOL=1
TRADE_SIZE_SOL=0.05
MAX_OPEN_POSITIONS=3
TAKE_PROFIT_PCT=60
STOP_LOSS_PCT=25
TRAILING_STOP_PCT=20
MAX_HOLD_MINUTES=15
DAILY_LOSS_LIMIT_SOL=0.25

# ---- Self-improvement and safety ----
AUTO_TUNE_EXITS=true
# The tuner never aims for more profit than this (percent). Your stop loss is never changed by the tuner.
MAX_TAKE_PROFIT_PCT=40
# How strict the team can get (0-1). Lower = more trades.
MAX_SCOUT_BAR=0.5
MAX_HUNTER_BAR=0.3
MAX_PROFESSOR_BAR=0.45
# Coins in the top X% of recent scores always pass, so the team keeps trading
TOP_PERCENT=12
COLD_MARKET_STRICTER=false
LOSS_STREAK_PAUSE=5
MAX_DRAWDOWN_PCT=30
COOLDOWN_MINUTES=60

# ---- WhatsApp alerts (optional, via CallMeBot) ----
# Add +34 694 25 79 52 to contacts, WhatsApp it "I allow callmebot to send me messages", it replies with your key.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
# all = every buy and sell, important = only breaker, tuned rules, mood and daily summary
WHATSAPP_ALERTS=all

# ---- REAL MONEY (leave off until the practice record is good) ----
LIVE_TRADING=false
PUMPPORTAL_API_KEY=
WALLET_PUBLIC_KEY=
MAX_LIVE_TRADE_SOL=0.25

# Testing only: fake coins instead of real pump.fun
SIMULATE=false
